{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.py"
    },
    {
      "source": "/home",
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    }
  ]
}
