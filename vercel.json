{
  "version": 2,
  "builds": [
    {
      "src": "api/server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.py"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|json|txt|xml))",
      "dest": "/webapp/$1"
    },
    {
      "src": "/",
      "dest": "/webapp/index.html"
    }
  ]
}

