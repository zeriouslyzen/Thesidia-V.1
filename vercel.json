{
  "version": 2,
  "builds": [
    {
      "src": "api/server.py",
      "use": "@vercel/python"
    },
    {
      "src": "webapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/server.py"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|json))",
      "dest": "webapp/$1"
    },
    {
      "src": "/",
      "dest": "webapp/index.html"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.13"
  },
  "functions": {
    "api/server.py": {
      "maxDuration": 60
    }
  }
}

