{
  "version": 2,
  "builds": [
    {
      "src": "api/server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.py"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server.py"
    }
  ],
  "functions": {
    "api/server.py": {
      "includeFiles": "public/**"
    }
  }
}

