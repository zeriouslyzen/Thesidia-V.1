{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.py"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|json|txt|xml))",
      "dest": "/webapp/$1"
    },
    {
      "src": "/",
      "dest": "/webapp/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  }
}

