# Supabase Environment Configuration
# Copy this to .env and fill in your Supabase project details

# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (safe for client-side)
# Used for client-side auth and API calls
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET - server-side only!)
# Used for admin operations, bypasses RLS
# ⚠️ NEVER commit this to git or expose to clients!
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: Enable Supabase storage (default: auto-detect based on SUPABASE_URL)
# USE_SUPABASE=true

# Development mode: Force SQLite even if Supabase configured
# USE_SQLITE=true
